# --- Core -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DATABASE_URL=            # e.g. postgres://user:pass@localhost:5432/school (blank = SQLite)
TIME_ZONE=Africa/Douala

# --- Frontend ---------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOW_ALL=1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Domain defaults (seed only - editable records in the DB) ----------------
DEFAULT_FEE_AMOUNT_XAF=60000
DEFAULT_REGISTRATION_FEE_XAF=10000
DEFAULT_MAX_CREDITS=30
ACTIVATION_TOKEN_TTL_HOURS=72

# --- Payments ---------------------------------------------------------------
# Sandbox: copy the pk_test / sk_test / *_test.* keys from the provider
# dashboards into your local .env (never commit .env). notchpay = real
# provider default (XAF / Mobile Money); stripe is selectable per request
# with {"provider": "stripe"} on POST /api/invoices/{id}/payments.
# mock = clearly-labelled fake simulation (tests/demo only).
PAYMENT_PROVIDER=notchpay
PAYMENT_ALLOW_MOCK=0
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_SECRET_KEY=
NOTCHPAY_HASH_KEY=
NOTCHPAY_BASE_URL=https://api.notchpay.co
NOTCHPAY_SANDBOX=1
NOTCHPAY_WEBHOOK_URL=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email --------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.edu

# --- Email --------------------------------------------------------------------
# Set EMAIL_BACKEND to smtp.EmailBackend to send real emails (e.g. via Gmail):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=your-email@gmail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#   EMAIL_USE_TLS=1
#   DEFAULT_FROM_EMAIL=your-email@gmail.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=no-reply@example.edu

# --- Emergency contacts (student -> admin) -----------------------------------
# Shown on the student "Contact administration" page. Blank = hidden.
UNIVERSITY_NAME=
EMERGENCY_CONTACT_EMAIL=emergency@example.edu
EMERGENCY_ALERT_EMAIL=
EMERGENCY_CONTACT_SECURITY_NAME=Campus Security (24/7)
EMERGENCY_CONTACT_SECURITY_PHONE=
EMERGENCY_CONTACT_MEDICAL_NAME=Campus Medical Centre
EMERGENCY_CONTACT_MEDICAL_PHONE=
EMERGENCY_CONTACT_WELFARE_NAME=Student Welfare & Counselling
EMERGENCY_CONTACT_WELFARE_PHONE=
EMERGENCY_CONTACT_ADMIN_NAME=Administration / Student Affairs
EMERGENCY_CONTACT_ADMIN_PHONE=
